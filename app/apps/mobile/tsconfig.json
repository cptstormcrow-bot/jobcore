{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "types": [
      "react",
      "expo"
    ]
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "*.ts",
    "*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "**/*.assert.ts"
  ],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/module-sdk"
    },
    {
      "path": "../../modules/admin-finance"
    },
    {
      "path": "../../modules/field-tech"
    },
    {
      "path": "../../modules/sales-marketing"
    },
    {
      "path": "../../modules/payment-review"
    }
  ]
}
