{
  "expo": {
    "name": "Jobcore",
    "slug": "jobcore",
    "scheme": "jobcore",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.sdassemblypros.jobcore",
      "supportsTablet": true
