{
  "expo": {
    "name": "JobCore©",
    "slug": "jobcore",
    "scheme": "jobcore",
    "owner": "wolfgaard-studio",
    "version": "0.8.7",
    "icon": "./assets/icon-1024.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.sdassemblypros.jobcore",
      "buildNumber": "9",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sdassemblypros.jobcore.v2",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground-1024.png",
        "backgroundColor": "#1B2A41"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-media-library",
      "expo-background-fetch",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e5206f71-f1c3-4c51-98e8-3c3f59eaab0a"
      }
    }
  }
}
