{
  "expo": {
    "name": "JobCore©",
    "slug": "jobcore",
    "scheme": "jobcore",
    "owner": "wolfgaard-studio",
    "version": "0.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.sdassemblypros.jobcore",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sdassemblypros.jobcore.v2",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-media-library",
      [
        "expo-image-picker",
        {
          "photosPermission": "Jobcore needs access to your photos so you can attach job photos.",
          "cameraPermission": "Jobcore needs camera access so you can take job photos."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e5206f71-f1c3-4c51-98e8-3c3f59eaab0a"
      }
    }
  }
}
