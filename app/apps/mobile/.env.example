# Jobcore — environment template. Copy to .env and fill in real values.
# Every EXPO_PUBLIC_* var is inlined into the client bundle at build time —
# ONLY non-secret, publishable values belong here. Never the service_role/secret key.

# Supabase project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (RLS-gated — safe for the client bundle)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional local price-sheet feed (S7 sdap_mock test-bed). Blank by default.
EXPO_PUBLIC_PRICEFEED_URL=

# Disable Watchman (fall back to Metro's native filesystem watcher) and cap
# Node's heap for the dev server process — both mitigations for the Metro
# file watcher OOM/handle-limit crash on Windows. Leave EXPO_NO_WATCHMAN
# commented out unless you hit that crash; Watchman should stay enabled
# by default for fast rebuilds.
#EXPO_NO_WATCHMAN=1
NODE_OPTIONS=--max-old-space-size=4096
