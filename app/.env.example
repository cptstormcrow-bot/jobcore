# Jobcore — environment template. Copy to `.env` and fill in real values.
# Every EXPO_PUBLIC_* var is inlined into the client bundle at build time —
# put ONLY non-secret, publishable values here (the anon key is safe to ship;
# it is gated by Row-Level Security, never the service_role key).

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (RLS-gated — safe for the client bundle)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional local price-sheet feed (S7 sdap_mock test-bed). Blank by default —
# a throwaway mock, never a hard dependency. Leave empty in normal builds.
EXPO_PUBLIC_PRICEFEED_URL=
